NODE_ENV=development
PORT=4000
# Address the API binds to. On the server use the LAN address or 0.0.0.0 behind a firewall.
HOST=127.0.0.1

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=nuvytrix
DB_PASSWORD=change-me
DB_NAME=nuvytrix

# Origin of the Angular app during development (ng serve). In Docker the frontend proxies /api, so this is same-origin.
FRONTEND_URL=http://localhost:4200
# Proxies whose X-Forwarded-For is trusted: a hop count or subnets. 0 when nothing proxies the API.
# With Docker Compose, trust only the Docker bridge networks the frontend nginx uses.
TRUST_PROXY=0
# Set to true only when the app is served over HTTPS.
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_MAX_AGE_HOURS=12

# Only these networks may be scanned. Comma-separated IPv4 CIDRs, each /22 or smaller.
ALLOWED_SCAN_CIDRS=192.168.100.0/24
NMAP_PATH=nmap
# true when nmap has CAP_NET_RAW but runs as non-root (set in the Docker image).
NMAP_PRIVILEGED=false
SCAN_TIMEOUT_SECONDS=180
# Run a discovery scan of the first allowed network every N minutes. 0 disables scheduled scans.
DISCOVERY_INTERVAL_MINUTES=0
# A device counts as offline when it was not seen in the last N minutes.
DEVICE_ONLINE_WINDOW_MINUTES=30

# Huawei logs timestamps in local time without an offset.
ROUTER_TIMEZONE=Europe/Belgrade
ROUTER_HOST=192.168.100.1
FIREWALL_UPLOAD_MAX_MB=20

PING_PATH=ping
MONITORING_INTERVAL_SECONDS=60
MONITORING_RETENTION_DAYS=90

# Optional AdGuard Home integration. Leave ADGUARD_URL empty when not installed.
ADGUARD_URL=
ADGUARD_USERNAME=
ADGUARD_PASSWORD=

# Docker Compose only: where the web container listens. Keep it on the LAN; never forward this port.
WEB_BIND=0.0.0.0
WEB_PORT=8080
